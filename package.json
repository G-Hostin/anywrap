{
  "name": "anywrap",
  "version": "0.1.0",
  "private": true,
  "description": "Drop any personal data export and get a year-in-review story. The AI picks the story; code computes every number, and each one comes with a receipt.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server/index.ts --dev",
    "build": "vite build",
    "start": "node server/index.ts",
    "test": "TZ=Europe/Paris node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "samples": "TZ=Europe/Paris node scripts/make-samples.ts",
    "check:live": "TZ=Europe/Paris node scripts/check-live.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "html-to-image": "^1.11.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
